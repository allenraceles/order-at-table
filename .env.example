# Copy to .env and replace with the restaupro project's Postgres connection string.
# Use the Transaction pooler connection if your network needs IPv4.
SUPABASE_DB_URL=postgresql://postgres.ftdzbagcesvujvrbaqdl:PASSWORD@POOLER_HOST:6543/postgres
# Browser-safe Supabase values from RestauPro → Project Settings → API Keys.
VITE_SUPABASE_URL=https://ftdzbagcesvujvrbaqdl.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_REPLACE_ME
# Comma-separated frontend origins allowed to call FastAPI in production.
ORDER_ALLOWED_ORIGINS=https://mesa-customer-ordering.raseresu.chatgpt.site,https://mesa-foh-dashboard.raseresu.chatgpt.site,https://mesa-kitchen-view.raseresu.chatgpt.site
# Set to the public FastAPI origin when building the hosted static apps.
VITE_API_BASE_URL=
# Shared staff key for the Front-of-house and Kitchen screens. Generate a long random value.
# Enter it in each staff screen; never use a VITE_ prefix or commit the real value.
ORDER_STAFF_KEY=REPLACE_WITH_A_LONG_RANDOM_SECRET
