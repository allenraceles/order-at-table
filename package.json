{
  "name": "mesa-workspace",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "pnpm dev:order",
    "dev:order": "pnpm --filter @mesa/order-at-table dev",
    "dev:foh": "pnpm --filter @mesa/front-of-house dev",
    "dev:kitchen": "pnpm --filter @mesa/kitchen-display dev",
    "build": "pnpm --filter './apps/*' build",
    "build:order": "pnpm --filter @mesa/order-at-table build",
    "build:foh": "pnpm --filter @mesa/front-of-house build",
    "build:kitchen": "pnpm --filter @mesa/kitchen-display build",
    "preview:order": "pnpm --filter @mesa/order-at-table preview",
    "preview:foh": "pnpm --filter @mesa/front-of-house preview",
    "preview:kitchen": "pnpm --filter @mesa/kitchen-display preview"
  }
}
